{
  "superstructure_name": "marine_alt_fuel_hybrid_power",
  "schema_version": "1.1.0",
  "description": "Structural decision space for a carbon-neutral marine propulsion power plant. Each enumerated case is one complete flowsheet topology; continuous operating variables are optimized inside a case.",
  "nodes": [
    {
      "id": "S1",
      "name": "feedstock",
      "label_ko": "연료 (Feed)",
      "label_en": "Feedstock",
      "options": [
        {
          "code": "NH3",
          "label_ko": "액체 암모니아",
          "label_en": "Liquid ammonia",
          "note": "18.6 MJ/kg LHV, 12.7 MJ/L, carbon free, toxic"
        },
        {
          "code": "MEOH",
          "label_ko": "메탄올",
          "label_en": "Methanol",
          "note": "19.9 MJ/kg LHV, 15.8 MJ/L, carbon bearing, liquid at ambient"
        },
        {
          "code": "LOHC",
          "label_ko": "LOHC",
          "label_en": "LOHC (MCH/DBT)",
          "note": "dehydrogenation only; the carrier (MCH or DBT) is a sub-choice and returns to shore"
        },
        {
          "code": "LH2",
          "label_ko": "액체 수소",
          "label_en": "Liquid hydrogen",
          "note": "no reforming, 20 K storage, boil-off and volume penalty"
        },
        {
          "code": "GLY",
          "label_ko": "글리세롤",
          "label_en": "Glycerol",
          "note": "biodiesel by-product, steam reforming route"
        }
      ]
    },
    {
      "id": "S2",
      "name": "hydrogen_production",
      "label_ko": "수소 생산 (개질/분해)",
      "label_en": "Hydrogen production",
      "options": [
        {
          "code": "NONE",
          "label_ko": "없음 (연료 직접 공급)",
          "label_en": "None (direct feed)",
          "note": "feed goes straight to the prime mover"
        },
        {
          "code": "PARTIAL",
          "label_ko": "부분 개질",
          "label_en": "Partial reforming",
          "note": "hydrogen only as a combustion promoter, remainder burned as feed"
        },
        {
          "code": "FULL",
          "label_ko": "완전 개질",
          "label_en": "Full reforming",
          "note": "conversion above 0.99 for fuel-cell grade gas"
        }
      ]
    },
    {
      "id": "S3",
      "name": "purification",
      "label_ko": "가스 정제",
      "label_en": "Purification",
      "options": [
        {
          "code": "NONE",
          "label_ko": "없음",
          "label_en": "None",
          "note": "diluted H2/N2 accepted by the consumer"
        },
        {
          "code": "PSA",
          "label_ko": "PSA",
          "label_en": "PSA",
          "note": "high purity, hydrogen recovery 0.75-0.90, compression duty"
        },
        {
          "code": "MEMB",
          "label_ko": "막분리",
          "label_en": "Membrane",
          "note": "compact and light, lower purity and recovery"
        }
      ]
    },
    {
      "id": "S4",
      "name": "prime_mover",
      "label_ko": "주 동력원",
      "label_en": "Prime mover",
      "options": [
        {
          "code": "SOFC",
          "label_ko": "SOFC",
          "label_en": "SOFC",
          "note": "700-850 C, internal cracking, slow load ramp"
        },
        {
          "code": "HTPEM",
          "label_ko": "HT-PEM",
          "label_en": "HT-PEM",
          "note": "160-180 C, CO tolerant, ammonia must still be removed"
        },
        {
          "code": "PEMFC",
          "label_ko": "LT-PEM",
          "label_en": "LT-PEM",
          "note": "80 C, ammonia below 0.1 ppm, fast ramp"
        },
        {
          "code": "ICE",
          "label_ko": "이중연료 엔진 단독",
          "label_en": "Dual fuel engine only",
          "note": "dual fuel engine on the S1 fuel with a pilot, fast ramp, NOx source (and N2O when the fuel is ammonia)"
        },
        {
          "code": "HYB",
          "label_ko": "SOFC + 엔진 하이브리드",
          "label_en": "SOFC + engine hybrid",
          "note": "fuel cell base load, engine peak and transient"
        }
      ]
    },
    {
      "id": "S5",
      "name": "reformer_heat_source",
      "label_ko": "개질기 열원",
      "label_en": "Reformer heat source",
      "options": [
        {
          "code": "NONE",
          "label_ko": "없음 (개질기 부재)",
          "label_en": "None (no reformer)",
          "note": "only valid when S2 is NONE"
        },
        {
          "code": "SOFCEXH",
          "label_ko": "SOFC 배기 고온열",
          "label_en": "SOFC exhaust heat",
          "note": "700-850 C, best exergy match, couples reformer duty to stack load"
        },
        {
          "code": "ANODEBURN",
          "label_ko": "Anode off-gas 촉매연소기",
          "label_en": "Anode off-gas burner",
          "note": "burns unconverted hydrogen, decouples reformer from stack temperature"
        },
        {
          "code": "FUELBURN",
          "label_ko": "연료 직접 연소",
          "label_en": "Direct fuel firing",
          "note": "simplest and fastest, consumes 15-20 percent of feed LHV"
        }
      ]
    },
    {
      "id": "S6",
      "name": "bottoming_cycle",
      "label_ko": "폐열 회수 (보조 전력)",
      "label_en": "Bottoming cycle",
      "options": [
        {
          "code": "NONE",
          "label_ko": "없음",
          "label_en": "None",
          "note": "reference case that prices the value of heat recovery"
        },
        {
          "code": "ORC",
          "label_ko": "ORC",
          "label_en": "ORC",
          "note": "source below 350 C, jacket water and scavenge air included"
        },
        {
          "code": "SRC",
          "label_ko": "Steam Rankine cycle",
          "label_en": "Steam Rankine",
          "note": "source above 400 C, feedwater treatment and volume penalty"
        },
        {
          "code": "KAL",
          "label_ko": "Kalina",
          "label_en": "Kalina",
          "note": "ammonia-water mixture, temperature glide matched to sensible sources"
        },
        {
          "code": "CASC",
          "label_ko": "Steam Rankine 상단 + ORC 하단",
          "label_en": "Steam topping + ORC bottoming",
          "note": "high grade heat to steam, rejected heat to ORC"
        }
      ]
    },
    {
      "id": "S7",
      "name": "aftertreatment",
      "label_ko": "배기 후처리",
      "label_en": "Aftertreatment",
      "options": [
        {
          "code": "NONE",
          "label_ko": "없음",
          "label_en": "None",
          "note": "only defensible when no combustor is present"
        },
        {
          "code": "SCR",
          "label_ko": "SCR",
          "label_en": "SCR",
          "note": "consumes one mole of ammonia per mole of NOx, produces N2O"
        },
        {
          "code": "SCR_ASC",
          "label_ko": "SCR + 암모니아 슬립 촉매",
          "label_en": "SCR + ammonia slip catalyst",
          "note": "adds a slip catalyst to hold ammonia slip below the limit"
        },
        {
          "code": "NORR",
          "label_ko": "NORR (전기화학 NOx→NH₃)",
          "label_en": "NORR (electrochemical NOx to NH3)",
          "note": "recovers ammonia instead of consuming it, pays an electrical duty"
        }
      ]
    },
    {
      "id": "S10",
      "name": "anode_recirculation",
      "label_ko": "Anode 재순환",
      "label_en": "Anode recirculation",
      "options": [
        {
          "code": "NONE",
          "label_ko": "없음",
          "label_en": "None",
          "note": "anode off-gas leaves on a single pass"
        },
        {
          "code": "BLOWER",
          "label_ko": "고온 블로워",
          "label_en": "Hot blower",
          "note": "mechanical recycle at stack temperature; a hot loop is worth 4.7 points over a cold one"
        },
        {
          "code": "EHC",
          "label_ko": "전기화학 수소압축기",
          "label_en": "Electrochemical hydrogen compressor",
          "note": "selective hydrogen recycle with no hot rotating machinery; must beat 6-8 kWh per kg of mechanical compression"
        }
      ]
    }
  ],
  "logic_cuts": [
    {
      "id": "LC01",
      "if": {
        "S4": [
          "PEMFC",
          "HTPEM"
        ],
        "S1": [
          "NH3",
          "MEOH",
          "LOHC",
          "GLY"
        ]
      },
      "then_require": {
        "S2": [
          "FULL"
        ]
      },
      "rationale": "Low temperature cells cannot crack or internally reform a carrier. Liquid hydrogen is exempt: it needs no reforming.",
      "kind": "dependency"
    },
    {
      "id": "LC02",
      "if": {
        "S4": [
          "PEMFC",
          "HTPEM"
        ],
        "S1": [
          "NH3",
          "MEOH",
          "LOHC",
          "GLY"
        ]
      },
      "then_forbid": {
        "S3": [
          "NONE"
        ]
      },
      "rationale": "Ammonia and residual carrier poison the membrane and ionomer at ppm level. Liquid hydrogen is exempt: it arrives already pure.",
      "kind": "dependency"
    },
    {
      "id": "LC03",
      "if": {
        "S4": [
          "SOFC",
          "HYB",
          "ICE"
        ]
      },
      "then_require": {
        "S3": [
          "NONE"
        ]
      },
      "rationale": "Scope choice: high temperature stacks and engines tolerate nitrogen dilution, so this study does not price a purifier for them. Not a statement that purification is impossible or never useful.",
      "kind": "scope",
      "rationale_before_review": "High temperature stacks and engines tolerate nitrogen dilution, so purification is pure CAPEX and recovery loss."
    },
    {
      "id": "LC04",
      "if": {
        "S4": [
          "ICE"
        ]
      },
      "then_forbid": {
        "S2": [
          "FULL"
        ]
      },
      "rationale": "Scope choice: this study uses hydrogen in an engine as a combustion promoter, so the engine takes partially cracked gas. A fully cracked engine feed is possible; it is outside this study.",
      "kind": "scope",
      "rationale_before_review": "An engine needs hydrogen only as a combustion promoter, not a fully cracked stream."
    },
    {
      "id": "LC05",
      "if": {
        "S2": [
          "NONE"
        ]
      },
      "then_require": {
        "S3": [
          "NONE"
        ],
        "S5": [
          "NONE"
        ]
      },
      "rationale": "With no reformer there is nothing to purify and no reformer duty to supply.",
      "kind": "dependency"
    },
    {
      "id": "LC06",
      "if": {
        "S2": [
          "PARTIAL",
          "FULL"
        ]
      },
      "then_forbid": {
        "S5": [
          "NONE"
        ]
      },
      "rationale": "Endothermic cracking and reforming must be heated; an unheated reformer is not a flowsheet.",
      "kind": "dependency"
    },
    {
      "id": "LC07",
      "if": {
        "S5": [
          "SOFCEXH"
        ]
      },
      "then_require": {
        "S4": [
          "SOFC",
          "HYB"
        ]
      },
      "rationale": "Only a solid oxide stack exhausts above the reformer temperature.",
      "kind": "dependency"
    },
    {
      "id": "LC08",
      "if": {
        "S5": [
          "ANODEBURN"
        ]
      },
      "then_forbid": {
        "S4": [
          "ICE"
        ]
      },
      "rationale": "An anode off-gas burner requires a fuel cell anode.",
      "kind": "dependency"
    },
    {
      "id": "LC09",
      "if": {
        "S7": [
          "SCR",
          "SCR_ASC",
          "NORR"
        ]
      },
      "then_require": {
        "S4": [
          "ICE",
          "HYB"
        ]
      },
      "rationale": "Scope choice: SCR, ASC and NORR are attached to the engine exhaust. A fuel-cell-only plant can still have burners (anode off-gas, fired heater); their emissions are counted at the stack but given no dedicated aftertreatment in this study.",
      "kind": "scope",
      "rationale_before_review": "A fuel-cell-only plant has no flame and produces negligible thermal NOx."
    },
    {
      "id": "LC10",
      "if": {
        "S4": [
          "ICE",
          "HYB"
        ]
      },
      "then_forbid": {
        "S7": [
          "NONE"
        ]
      },
      "rationale": "Scope choice: the study assumes operation inside an emission control area, where an ammonia or hydrogen engine is taken to need aftertreatment. Not a universal rule for every engine, load and test cycle.",
      "kind": "scope",
      "rationale_before_review": "IMO Tier III inside an emission control area cannot be met by an ammonia or hydrogen engine without aftertreatment."
    },
    {
      "id": "LC11",
      "if": {
        "S7": [
          "NORR"
        ]
      },
      "then_require": {
        "S1": [
          "NH3"
        ]
      },
      "rationale": "Scope choice: recovered ammonia closes a loop only when ammonia is the feed; with other feeds it would be a by-product this study does not value.",
      "kind": "scope",
      "rationale_before_review": "Recovered ammonia only closes a loop when ammonia is the feed; otherwise it is an unsold by-product."
    },
    {
      "id": "LC12",
      "if": {
        "S4": [
          "PEMFC",
          "HTPEM"
        ]
      },
      "then_require": {
        "S6": [
          "NONE",
          "ORC"
        ]
      },
      "rationale": "Scope choice: the study does not pair low temperature cells with steam, Kalina or cascaded cycles. That is a net output and pinch judgement for this study, not a claim that such cycles cannot run from a source below 200 C.",
      "kind": "scope",
      "rationale_before_review": "A heat source below 200 C cannot drive a steam, Kalina or cascaded cycle."
    },
    {
      "id": "LC13",
      "if": {
        "S1": [
          "LH2"
        ]
      },
      "then_require": {
        "S2": [
          "NONE"
        ]
      },
      "rationale": "Liquid hydrogen is already the product of reforming.",
      "kind": "dependency"
    },
    {
      "id": "LC14",
      "if": {
        "S1": [
          "LOHC"
        ]
      },
      "then_forbid": {
        "S2": [
          "NONE"
        ]
      },
      "rationale": "Scope boundary: LOHC enters this study only as a hydrogen carrier returned ashore, so the carrier is always dehydrogenated. Using a carrier as a fuel directly is a different technology, outside this study.",
      "kind": "scope",
      "rationale_before_review": "A carrier such as MCH cannot be fed to any converter without dehydrogenation."
    },
    {
      "id": "LC15",
      "if": {
        "S1": [
          "GLY"
        ]
      },
      "then_require": {
        "S2": [
          "FULL"
        ]
      },
      "rationale": "Scope boundary: glycerol enters this study only through steam reforming. Other uses of glycerol are not ruled out physically; they are not studied here.",
      "kind": "scope",
      "rationale_before_review": "Glycerol requires steam reforming; it is neither a direct engine fuel nor a fuel cell feed."
    },
    {
      "id": "LC16",
      "if": {
        "S10": [
          "BLOWER",
          "EHC"
        ]
      },
      "then_require": {
        "S4": [
          "SOFC",
          "HYB"
        ]
      },
      "rationale": "Anode recirculation needs a fuel cell anode to recycle from.",
      "kind": "dependency"
    }
  ],

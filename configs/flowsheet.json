    {
      "id": "ASC",
      "x": 908,
      "y": 600,
      "label": "Slip catalyst",
      "label_ko": "암모니아 슬립 촉매",
      "active_when": {
        "S7": [
          "SCR_ASC"
        ]
      },
      "rationale": "Redundant while ammonia is dosed at or below one mole per mole of NOx. It earns its place because `nh3_to_nox_ratio` runs to 1.20: over-dosing buys deNOx conversion and needs a slip catalyst to stay under 10 ppm."
    },

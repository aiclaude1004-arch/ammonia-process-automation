    {
      "id": "POWER",
      "x": 1268,
      "y": 298,
      "label": "Net power boundary",
      "label_ko": "순출력 경계",
      "rationale": "Not a generator. Gross output from the stack, engine and turbines minus every parasitic load - pumps, compressors, blowers, EHC, NORR, recovery.",
      "kind": "boundary"
    },
    {
      "id": "ANODEREC",
      "x": 545,
      "y": 210,
      "label": "Anode recycle",
      "label_ko": "Anode 재순환",
      "rationale": "Returns unconverted hydrogen from the anode instead of letting it leave on a single pass. Whether that helps an ammonia stack is disputed: the recycle saves fuel but the blower or compressor draws parasitic power, and published results differ on which wins.",
      "active_when": {
        "S10": [
          "BLOWER",
          "EHC"
        ]
      },
      "dynamic_label": {
        "S10": {
          "BLOWER": "Recycle blower",
          "EHC": "Electrochem. compressor"
        }
      }
    },
    {
      "id": "AIR",
      "x": 545,
      "y": 34,
      "kind": "boundary",
      "label": "Ambient air",
      "label_ko": "대기 공기",
      "active_when": {},
      "rationale": "Where combustion and cathode air enters. Without it the blower appears to make oxygen."
    },
    {
      "id": "AOG_SPLITTER",
      "x": 718,
      "y": 122,
      "label": "Anode off-gas split",
      "label_ko": "Anode off-gas 분배",
      "active_when": {
        "S4": [
          "SOFC",
          "HYB"
        ]
      },
      "rationale": "One anode outlet with several destinations - engine in the series hybrid, burner, recycle, purge. The fractions must sum to one, so the split is a unit rather than separate arrows from the stack that could each claim the whole flow."
    },
    {
      "id": "LOHC_SEP",
      "x": 545,
      "y": 298,
      "label": "Carrier separator",
      "label_ko": "탈수소 기액분리",
      "active_when": {
        "S1": [
          "LOHC"
        ]
      },
      "dynamic_label": {
        "LOHC_CARRIER": {
          "MCH": "MCH / toluene KO",
          "DBT": "H0-DBT KO"
        }
      },
      "rationale": "Dehydrogenation returns hydrogen and spent carrier together. The carrier and its vapour are knocked out before the hydrogen goes on, and the carrier is kept for return ashore rather than counted as fuel."
    },
    {
      "id": "CARRIER",
      "x": 30,
      "y": 420,
      "kind": "boundary",
      "label": "Spent carrier tank",
      "label_ko": "캐리어 회수 탱크",
      "active_when": {
        "S1": [
          "LOHC"
        ]
      },
      "dynamic_label": {
        "LOHC_CARRIER": {
          "MCH": "Toluene tank",
          "DBT": "H0-DBT tank"
        }
      },
      "rationale": "Closes the carbon balance of the carrier: everything that came aboard as MCH or H18-DBT leaves as toluene or H0-DBT, or as an explicit loss."
    },
    {
      "id": "PILOT",
      "x": 372,
      "y": 600,
      "kind": "boundary",
      "label": "Pilot fuel",
      "label_ko": "파일럿 연료",
      "active_when": {
        "S4": [
          "ICE",
          "HYB"
        ]
      },
      "rationale": "A compression ignition ammonia engine needs a pilot fuel to ignite. It is a carbon source in the balance even when the main fuel carries no carbon."
    },
    {
      "id": "NORR_PRE",
      "x": 718,
      "y": 688,
      "label": "NOx capture",
      "label_ko": "NOx 흡수·전처리",
      "active_when": {
        "S7": [
          "NORR"
        ]
      },
      "rationale": "An electrolyser cannot take engine exhaust directly. NO is captured and concentrated first; the lean exhaust leaves separately."
    },
    {
      "id": "NH3REC",
      "x": 908,
      "y": 776,
      "label": "NH3 recovery",
      "label_ko": "NH3 회수·정제",
      "active_when": {
        "S7": [
          "NORR"
        ]
      },
      "rationale": "The cell makes ammonia in electrolyte, not tank-grade ammonia. It is stripped, dried and brought to tank pressure before it is fuel again."
    },
    {
      "id": "MAKEUP",
      "x": 908,
      "y": 34,
      "kind": "boundary",
      "label": "Demin make-up",
      "label_ko": "탈염수 보급",
      "active_when": {
        "any_of": [
          {
            "S6": [
              "SRC",
              "CASC"
            ]
          },
          {
            "S7": [
              "NORR"
            ]
          }
        ]
      },
      "rationale": "Utility water for the steam cycle and the NOx electrolyser, kept apart from the reformer process water it used to share a block with."
    },
    {
      "id": "DRAIN",
      "x": 1088,
      "y": 776,
      "kind": "boundary",
      "label": "Liquid discharge",
      "label_ko": "배출수·블로다운",
      "active_when": {
        "any_of": [
          {
            "S1": [
              "MEOH",
              "GLY"
            ],
            "S2": [
              "PARTIAL",
              "FULL"
            ]
          },
          {
            "S6": [
              "SRC",
              "CASC"
            ]
          },
          {
            "S7": [
              "NORR"
            ]
          }
        ]
      },
      "rationale": "Condensate bleed, boiler blowdown and spent electrolyte leave here, so the liquid balance closes instead of every liquid being assumed reused."
    }

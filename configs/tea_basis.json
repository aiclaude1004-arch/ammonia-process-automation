  "method_equations": [
    {
      "id": "T1",
      "name": "참조 흐름 (기능단위당 연료)",
      "eq": "ṁ_NH3 = 3600 / (η_net · LHV_NH3)   [kg / MWh_net]",
      "symbols": "η_net 순효율 [-], LHV_NH3 = 18.6 MJ/kg (superstructure S1 주석)",
      "from": "모사 결과 η_net",
      "source": "정의",
      "note": "모든 TEA·LCA 수치가 이 한 줄에서 갈라진다. 효율이 낮으면 같은 1 MWh에 연료를 더 쓰고, 그것이 연료비와 상류 배출로 그대로 옮겨 간다."
    },
    {
      "id": "T2",
      "name": "장비 원가 규모 보정",
      "eq": "C = C_ref · (S / S_ref)^n",
      "symbols": "S 크기(kW, m², kmol/h …), n 규모지수(장치별, 흔히 0.5–0.8)",
      "from": "원가 DB (지금 비어 있음)",
      "source": "교과서 관행 — 쓰는 판본을 논문에 명시",
      "note": "n을 장치마다 따로 둔다. 하나의 n을 전체에 쓰면 큰 장치와 작은 장치의 비용이 함께 틀어진다."
    },
    {
      "id": "T3",
      "name": "연도 보정 (CEPCI)",
      "eq": "C_기준연도 = C_출처연도 · (CEPCI_기준연도 / CEPCI_출처연도)",
      "symbols": "CEPCI: Chemical Engineering Plant Cost Index",
      "from": "지수 값 (연도별)",
      "source": "Chemical Engineering 지수 — 사용한 연도와 값을 표에 적는다",
      "note": "출처마다 원가 연도가 다르므로, 보정 전에는 서로 더할 수 없다."
    },
    {
      "id": "T4",
      "name": "설치·총투자비",
      "eq": "C_installed = C_equipment · f_install ;  TCI = Σ C_installed + 간접비 + 예비비 + 운전자본",
      "symbols": "f_install 설치계수(Lang 계수 또는 bare-module 계수)",
      "from": "계수 가정 (미조사)",
      "source": "교과서 관행",
      "note": "선박은 육상 플랜트와 설치 조건이 달라, 육상 계수를 그대로 쓰면 과대평가가 된다. 쓰는 계수의 근거를 논문에 밝혀야 한다."
    },
    {
      "id": "T5",
      "name": "자본회수계수",
      "eq": "CRF = i(1+i)^N / [(1+i)^N − 1]",
      "symbols": "i 할인율, N 수명(년)",
      "from": "경제 가정 (미조사)",
      "source": "정의",
      "note": "i와 N은 결과를 가장 크게 좌우하는 두 숫자다. 민감도 분석에 반드시 넣는다."
    },
    {
      "id": "T6",
      "name": "교체 항목의 연간화",
      "eq": "A_replace = C_replace · SFF,   SFF = i / [(1+i)^L − 1]",
      "symbols": "L 교체 주기(년) — 스택, 촉매, 막",
      "from": "교체 주기·단가 (미조사)",
      "source": "ijhe2024-stack-replacement-lcoh",
      "note": "스택 교체를 CAPEX로 반복 계상할지 OPEX로 녹일지 하나로 정하고 모든 케이스에 같게 쓴다. 읽은 문헌은 수명·원가가 프로젝트 기간에 변한다는 점까지 다룬다."
    },
    {
      "id": "T7",
      "name": "운전비",
      "eq": "OPEX = Σ(소비량 × 단가) + f_maint · CAPEX + 인건비 + A_replace",
      "symbols": "소비량: 암모니아, 파일럿 연료, 물, 환원제, 수입 전력",
      "from": "모사 소비량 + 단가(미조사)",
      "source": "sustain2025-nh3-decomp-tea",
      "note": "읽은 분해 TEA에서는 LCOH의 99 %까지가 암모니아 원료비였다. 우리 결과도 연료비가 지배할 가능성이 크므로 암모니아 가격은 단일값이 아니라 범위로 돌린다."
    },
    {
      "id": "T8",
      "name": "균등화 발전원가 (단순 연간화)",
      "eq": "LCOE = (TCI · CRF + OPEX_annual) / E_net,annual",
      "symbols": "E_net,annual = P_net × 연간 운전시간",
      "from": "위 항목 전부",
      "source": "정의",
      "note": "연간 비용과 발전량이 매년 같다고 볼 때만 성립한다."
    },
    {
      "id": "T9",
      "name": "균등화 발전원가 (할인 현금흐름)",
      "eq": "LCOE = Σ_t (I_t + O_t)(1+i)^−t  ⁄  Σ_t E_t (1+i)^−t",
      "symbols": "I_t 투자, O_t 운전비, E_t 발전량 (연도 t)",
      "from": "연도별 현금흐름",
      "source": "정의",
      "note": "교체가 특정 연도에 몰리거나 가동률이 변하면 이 쪽을 쓴다. 두 식 중 무엇을 썼는지 반드시 밝힌다."
    },
    {
      "id": "T10",
      "name": "탄소 저감비용",
      "eq": "CAC = (LCOE_대상 − LCOE_기준) / (e_기준 − e_대상)   [$ / tCO₂-eq]",
      "symbols": "e 배출강도 [tCO₂-eq/MWh] — TtW인지 WtW인지 반드시 명시",
      "from": "LCOE + LCA 결과",
      "source": "jmse2024-mac-method · martra2024-macc-shipping",
      "note": "해운 전체 MACC 기준선: 2030년 50–100, 2040년 230–240, 2050년 약 300 USD/tCO₂. 우리 값이 이보다 훨씬 크면 그 자체가 결과다(읽은 암모니아 발전 연구의 CAC는 4,510 $/tCO₂였다)."
    },
    {
      "id": "T11",
      "name": "(선택) 엑서지경제 SPECO",
      "eq": "Σ Ċ_out,k + Ċ_w,k = Σ Ċ_in,k + Ż_k ,   Ċ_j = c_j · Ė_j",
      "symbols": "Ż_k 장치 k의 투자비율[$/h], c_j 비엑서지비용[$/GJ]",
      "from": "엑서지 해석 + 장비 원가",
      "source": "energy2024-exergy-methods · ese2018-gt-src-orc-exergoecon",
      "note": "필수는 아니다. 다만 “왜 이 구조가 비싼가”를 장치 단위로 나눠 보여 줄 수 있고, 적용 예에서는 연소기가 비용 손실의 최대 지점이었다."
    }
  ]

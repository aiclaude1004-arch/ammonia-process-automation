{
  "purpose": "Cost database for the superstructure, joined to the process database on Case ID.",
  "status": "skeleton written 2026-09-20; every cost field is empty (미조사) until it is collected from a named source. An empty field is not zero.",
  "functional_unit": "1 MWh of net electricity delivered (the same basis as the LCA database)",
  "formulas": {
    "capex_scaling": "C = C_ref * (S / S_ref)^n",
    "cost_year_normalisation": "C_2026 = C_year * CEPCI_2026 / CEPCI_year",
    "installed_cost": "C_installed = C_equipment * f_installation",
    "annualisation": "CRF = i (1+i)^N / ((1+i)^N - 1)",
    "levelised_cost": "LCOE = (CAPEX * CRF + OPEX_annual) / E_net,annual",
    "note": "Replacement items (stack, catalyst, membrane) enter either as a sinking fund in OPEX or as repeated CAPEX; state which, and use one convention for every case."
  },
